# Copy this file to .env (or set the variables in your environment).
# ClearCommit TaskForge reads keys from the environment or %APPDATA%\LiveInterpreter\.env.
GROQ_API_KEY=your_groq_key_here
DEEPGRAM_API_KEY=your_deepgram_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Optional: AI provider for Conversation Clarity (groq | openrouter | custom)
TASKFORGE_AI_PRESET=groq
